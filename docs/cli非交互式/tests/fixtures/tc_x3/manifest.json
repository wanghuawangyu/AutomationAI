{
  "kind": "workflow",
  "schemaVersion": 1,
  "appVersion": "0.1.0",
  "exportedAtMs": "0",
  "workflow": { "name": "wf_tc_x3_multi", "version": 1 },
  "clients": [
    { "name": "Claude Code", "file": "clients/Claude Code.yaml" },
    { "name": "bash-build", "file": "clients/bash-build.yaml" }
  ],
  "ops": [
    { "name": "op_prompt_review", "version": 1, "file": "ops/op_prompt_review.yaml" },
    { "name": "op_bash_build", "version": 1, "file": "ops/op_bash_build.yaml" }
  ],
  "bindings": [
    { "opName": "op_prompt_review", "bindings": { "code": { "kind": "literal", "value": "sample" } }, "clientName": "Claude Code" },
    { "opName": "op_bash_build", "bindings": { "target": { "kind": "workflow_input", "inputName": "env" } }, "clientName": "bash-build" }
  ]
}